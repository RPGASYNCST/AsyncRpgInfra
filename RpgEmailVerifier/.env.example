# Conexão com o MariaDB (obrigatória)
# Caracteres especiais na senha precisam ser codificados (ex: '#' -> %23, '@' -> %40)
DATABASE_URL=mysql://asyncrpgadmin:troque_esta_senha_segura@127.0.0.1:3306/asyncrpg

# Endereço e porta do serviço verificador web
VERIFIER_HOST=0.0.0.0
VERIFIER_PORT=8081

# URL pública base para montar o link enviado no e-mail (ex: http://127.0.0.1:8081 ou https://rpgasyncst.local)
PUBLIC_VERIFY_BASE_URL=http://127.0.0.1:8081

# IP ou rede (CIDR) do proxy reverso confiável para leitura de X-Forwarded-For / X-Real-IP
TRUSTED_PROXIES=

# Permite o token de demonstração ACT-98-7741-KHR para visualização do layout sem banco (padrão: false)
ALLOW_DEMO_TOKEN=false

# Configurações opcionais de SMTP para envio direto do e-mail pelo RpgEmailVerifier
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=asyncttrpg@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=asyncttrpg@gmail.com
SMTP_FROM_NAME=RPGASYNCST
SMTP_USE_TLS=true

# Nível de log
RUST_LOG=rpg_email_verifier=info,tower_http=info

