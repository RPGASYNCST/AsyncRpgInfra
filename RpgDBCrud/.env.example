# String de conexão com o MariaDB (obrigatória).
# Caracteres especiais da senha precisam ser codificados na URL (ex.: '#' vira %23, '@' vira %40).
DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/asyncrpg

# Endereço e porta onde a API REST vai escutar
API_HOST=0.0.0.0
API_PORT=8080

# Nível de log
RUST_LOG=rpg_db_crud=debug,tower_http=info

