# String de conexão com o MariaDB (obrigatória).
# Caracteres especiais da senha precisam ser codificados na URL (ex.: '#' vira %23, '@' vira %40).
DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/asyncrpg

# Endereço e porta onde a API REST vai escutar
API_HOST=0.0.0.0
API_PORT=8080

# Nível de log
RUST_LOG=rpg_db_crud=debug,tower_http=info

# IP ou rede (CIDR) do proxy reverso, separados por vírgula. Só deles a API aceita
# X-Forwarded-For/X-Real-IP. Vazio = usa o IP da conexão (correto sem proxy).
TRUSTED_PROXIES=

# Validade do login em horas (padrão 168 = 7 dias).
SESSAO_HORAS=168

# Admin inicial, criado na subida se ainda não existir (a senha de um usuário existente
# nunca é alterada por aqui). Senha: 10 a 128 caracteres e diferente do login.
ADMIN_LOGIN=
ADMIN_SENHA=

